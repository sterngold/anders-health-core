{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anders-health-core/raw-record-envelope.schema.json",
  "title": "RawRecordEnvelope",
  "type": "object",
  "required": ["subject_id", "source_id", "source_contract_version", "source_record_key", "source_version", "payload", "event_start_utc", "timestamp_precision", "local_date", "day_policy_version", "ingested_at"],
  "properties": {
    "subject_id": {"type": "string", "format": "uuid"},
    "source_id": {"type": "string"},
    "source_contract_version": {"type": "string", "minLength": 1},
    "source_record_key": {"type": "string", "minLength": 1},
    "source_version": {"type": "integer", "minimum": 1},
    "payload": {"type": "object"},
    "event_start_utc": {"type": ["string", "null"], "format": "date-time"},
    "event_end_utc": {"type": ["string", "null"], "format": "date-time"},
    "timestamp_precision": {"type": "string", "enum": ["date", "instant", "interval"]},
    "source_timezone": {"type": ["string", "null"]},
    "offset_minutes": {"type": ["integer", "null"], "minimum": -840, "maximum": 840},
    "local_date": {"type": "string", "format": "date"},
    "day_policy_version": {"type": "string"},
    "source_updated_at": {"type": ["string", "null"], "format": "date-time"},
    "ingested_at": {"type": "string", "format": "date-time"},
    "tombstone": {"type": "boolean"}
  },
  "allOf": [
    {
      "if": {"properties": {"timestamp_precision": {"const": "date"}}, "required": ["timestamp_precision"]},
      "then": {"properties": {"event_start_utc": {"type": "null"}, "event_end_utc": {"type": ["null"]}}}
    },
    {
      "if": {"properties": {"timestamp_precision": {"const": "instant"}}, "required": ["timestamp_precision"]},
      "then": {"properties": {"event_start_utc": {"type": "string", "format": "date-time"}, "event_end_utc": {"type": ["null"]}}, "anyOf": [{"required": ["source_timezone"], "properties": {"source_timezone": {"type": "string"}}}, {"required": ["offset_minutes"], "properties": {"offset_minutes": {"type": "integer"}}}]}
    },
    {
      "if": {"properties": {"timestamp_precision": {"const": "interval"}}, "required": ["timestamp_precision"]},
      "then": {
        "required": ["event_end_utc"],
        "properties": {
          "event_start_utc": {"type": "string", "format": "date-time"},
          "event_end_utc": {"type": "string", "format": "date-time"}
        },
        "anyOf": [{"required": ["source_timezone"], "properties": {"source_timezone": {"type": "string"}}}, {"required": ["offset_minutes"], "properties": {"offset_minutes": {"type": "integer"}}}]
      }
    }
  ],
  "additionalProperties": false
}
