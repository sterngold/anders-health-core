{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/anders-health-core/analytics-result.schema.json",
  "title": "AnalyticsResult",
  "type": "object",
  "required": ["result_id", "result_type", "subject_id", "status", "method_version", "policy_version", "input_snapshot_hash", "generated_at"],
  "properties": {
    "result_id": {"type": "string", "format": "uuid"},
    "result_type": {"type": "string", "enum": ["coverage", "trend", "association", "assessment_change"]},
    "subject_id": {"type": "string", "format": "uuid"},
    "status": {"type": "string"},
    "method_version": {"type": "string"},
    "policy_version": {"type": "string"},
    "input_snapshot_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "paired_count": {"type": "integer", "minimum": 0},
    "claim_type": {"type": "string", "enum": ["observational"]}
  },
  "additionalProperties": false
}
